{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:analyst:evidence-packet-v1",
  "title": "Evidence Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "created_at",
    "decision_cutoff",
    "adapter",
    "source",
    "request",
    "instrument",
    "observations",
    "quality"
  ],
  "properties": {
    "schema_version": {"const": "evidence-packet-v1"},
    "packet_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "decision_cutoff": {"type": "string", "format": "date-time"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "url", "retrieved_at", "raw_sha256", "rights"],
      "properties": {
        "authority": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rights": {"type": "string", "minLength": 1}
      }
    },
    "request": {"type": "object"},
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "symbol", "asset_class", "resolution_status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "asset_class": {"type": "string", "minLength": 1},
        "venue": {"type": ["string", "null"]},
        "resolution_status": {"const": "resolved"}
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id", "field", "value", "unit", "currency",
          "classification", "event_time", "published_at", "as_of",
          "revision", "source_locator"
        ],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "field": {"type": "string", "minLength": 1},
          "value": {},
          "unit": {"type": ["string", "null"]},
          "currency": {"type": ["string", "null"]},
          "classification": {
            "enum": ["reported_fact", "derived_fact", "estimate", "scenario", "opinion"]
          },
          "event_time": {"type": "string"},
          "published_at": {"type": "string"},
          "as_of": {"type": "string"},
          "revision": {"type": "object"},
          "source_locator": {"type": "string", "minLength": 1},
          "metadata": {"type": "object"}
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "flags", "errors"],
      "properties": {
        "status": {"enum": ["pass", "warning", "fail"]},
        "flags": {"type": "array", "items": {"type": "string"}},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
